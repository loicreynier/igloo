# vim: ft=gitconfig

[user]
	name = Loïc Reynier
	email = contact@loicreynier.fr
	signingkey = contact@loicreynier.fr
[core]
	pager = cat
	autocrlf = input
[color]
	ui = auto
[advice]
	skippedCherryPicks = false
	forceDeleteBranch = false
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[diff]
	algorithm = histogram
[log]
	data = iso
[push]
	default = current
	autoSetupRemote = true
rebase = true
[pull]
	rebase = true
[rere]
	enabled = true
[alias]
	log1 = "log --oneline"
	log1d = "log --pretty=log1d --date=relative"
	reflogd = "reflog --pretty=reflogd"
	push-all = "!git remote | xargs -L1 git push --all"
	stash-untracked = "!f() { git stash; git stash -u; git stash pop stash@{1}; }; f"
	ch = "!git checkout $(git branch --sort='-committerdate' | fzf --reverse)"
	sf = "!bash -c ' \
		source \"$HOME/.config/bash/functions/fzf-git-stage.bash\" || exit 1; \
		declare -F __fzf_git_stage >/dev/null \
			|| { echo \"Error: '__fzf_git_stage' Bash function not found\" >&2; exit 1; }; \
		__fzf_git_stage \
	'"
[pretty]
	log1d = "format:%C(blue)%>(22)%ad %C(yellow)%h %C(red)%d %C(reset)%s"
	reflogd = "format:%C(auto)%h %d %<|(17)%gD %<|(30)%C(blue)%cr%C(reset) %C(reset)%gs"
