# ~/.inputrc

# Check active bindings with: bind -P
# Check options with: bind -v
# Reload configuration with: bind -f ~/.config/inputrc

# Keymaps
# Necessary to bind stty special characters
# Source:
# https://stackoverflow.com/questions/23349325/inputrc-override-controlw
set bind-tty-special-chars off

"\C-g": undo
"\C-w": backward-kill-word
"\C-n": history-substring-search-forward
"\C-p": history-substring-search-backward
"\C-i": menu-complete
"\C-o": menu-complete-backward

$if Bash
  Space: magic-space # History expansion "!!<Space> -> expand last command"
$endif

# 8bit input
set input-meta on
set output-meta on
set convert-meta off

# Smart completion
set completion-ignore-case on
set completion-map-case on
set skip-completed-text on
set match-hidden-files off # Don't match dotfile if not specified
set mark-symlinked-directories off

# Menu completion on repeated "<Tab>" key press
set menu-complete-display-prefix on
set show-all-if-ambiguous on

# History
set history-preserve-point on

# Interpret pasted command as a single input
set enable-bracketed-paste on

# Make it sexy
set colored-stats on
set colored-completion-prefix on
set blink-matching-paren on

# Shut the fuck up
set bell-style none

# vim: ft=readline
